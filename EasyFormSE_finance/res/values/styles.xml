<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <style name="RedHUGEText">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:textColor">#F75D59</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="maulik">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFAF0</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="ImageTitle">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:background">#99000000</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#fff</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18dp</item>
        <item name="android:typeface">sans</item>
    </style>

    <style name="ButtonContainer">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">#99000000</item>
    </style>

    <style name="ButtonCon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">#99000000</item>
    </style>


    <style name="CustomProgressBarHorizontal" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:minHeight">10dip</item>
        <item name="android:maxHeight">20dip</item>
    </style>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.    -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="android:statusBarColor">?attr/colorOnSecondary</item>
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="colorAccent">#2A3086</item>
        <item name="android:colorAccent">#2A3086</item>
        <item name="android:windowIsTranslucent">false</item>
        <!-- The system navigation bar continues the app's bottom tab bar
             (#ecedef) instead of sitting under it as a black strip; dark
             buttons/handle so they stay visible on the light colour. -->
        <item name="android:navigationBarColor">#ECEDEF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Native dialogs (date/time pickers, confirmations) get the same
             16dp corners on all four sides as the app's own pop-ups. -->
        <item name="android:dialogCornerRadius" tools:targetApi="p">16dp</item>
        <item name="dialogCornerRadius">16dp</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
        <item name="alertDialogTheme">@style/AppAlertDialog.Compat</item>

        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
    </style>

    <!-- Native dialogs: white squircle window (dialog_squircle_bg). -->
    <style name="AppAlertDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_squircle_bg</item>
        <item name="android:colorAccent">#2A3086</item>
    </style>

    <style name="AppAlertDialog.Compat" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_squircle_bg</item>
        <item name="colorPrimary">#2A3086</item>
        <item name="colorAccent">#2A3086</item>
    </style>

    <style name="ToolBarStyle" parent="AppBaseTheme">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="actionMenuTextColor">@android:color/white</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="Widget.AppTheme.ActionBar.Fullscreen" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.AppTheme.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

</resources>