<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="6">

    <fragment xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5.5"
        tools:context="com.example.chetanpatel.mapp.MapsActivity">

        <ImageButton
            android:id="@+id/sitebtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|top"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/my_site_button"
            android:padding="10dp"
            android:paddingLeft="10dp"
            android:src="@drawable/ttower_icon" />
    </fragment>

    <LinearLayout
        android:id="@+id/lay_fetching"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.5"
            android:background="@drawable/support_layout_border"
            android:gravity="center"
            android:text="BACK"
            android:visibility="gone"
            android:textColor="@color/white"
            />
        <ProgressBar
            android:id="@+id/progress_bar"
            android:background="@drawable/support_layout_border"
            android:layout_width="0dp"
            android:layout_weight="0.2"
            android:gravity="center"
            android:indeterminateDrawable="@drawable/progress"
            android:layout_height="match_parent"/>
        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/support_layout_border"
            android:layout_gravity="center"
            android:layout_weight="0.8"
            android:gravity="center"
            android:text="Fetching Location"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>