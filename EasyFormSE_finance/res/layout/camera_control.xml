<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    android:id="@+id/fullpreview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginBottom="5dp"
    android:gravity="center"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">




    <LinearLayout android:id="@+id/preview_deg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_gravity="bottom">
        <!--    xmlns:android="http://schemas.android.com/apk/res/android">-->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.33"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="MF"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtmgnt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text="MF"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!--<ZoomControls-->
        <!--android:id="@+id/CAMERA_ZOOM_CONTROLS"-->
        <!--android:layout_width="0dp"-->
        <!--android:layout_height="wrap_content"-->
        <!--android:visibility="gone"-->
        <!--android:layout_weight="1.5">-->

        <!--</ZoomControls>-->

        <ImageView
            android:id="@+id/captureFront"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_weight="0.33"
            android:onClick="onClick"
            android:src="@drawable/cameraclick_foreground"
            android:text="" />



        <ImageView
            android:id="@+id/flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_weight="0.33"
            android:src="@drawable/flashon_foreground"
            android:text="" />




    </LinearLayout>

</LinearLayout>
