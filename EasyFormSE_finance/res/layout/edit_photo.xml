<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:descendantFocusability="beforeDescendants"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/ChoosenImageView_lay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_above="@+id/liner_savebtn"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:scaleType="matrix"
            android:adjustViewBounds="true"/>

        <ImageView
            android:id="@+id/img_edit"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_gravity="end"
            android:src="@drawable/edit"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/liner_savebtn"
        android:layout_width="match_parent"
        android:layout_height="50sp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="3sp"
        android:background="@color/black"
        android:layout_alignParentBottom="true"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/layColor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnColor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/selectercolor"
                android:padding="10dp"
                android:src="@drawable/color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layErase"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnErase"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/selectereraser"
                android:padding="10dp"
                android:src="@drawable/eraser" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layBrush"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnBrush"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/selecterbrush"
                android:padding="10dp"
                android:src="@drawable/brush"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/laysave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/selectersave"
                android:padding="10dp"
                android:src="@drawable/check_mark"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="50dp"
        android:gravity="end|bottom">

        <com.sky.atc.easyformse.VerticalSeekBar
            android:id="@+id/seekBar1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/seek_height"
            android:layout_marginBottom="@dimen/margin_bottom"
            android:max="20" />
    </LinearLayout>
</RelativeLayout>