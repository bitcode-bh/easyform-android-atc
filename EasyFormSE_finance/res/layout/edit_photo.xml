<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/Layoutbtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:background="#80337ab7"
        android:gravity="center|bottom"
        android:visibility="gone"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/layColor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selectercolor"
                android:padding="10dp"
                android:src="@drawable/color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layErase"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnErase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selectereraser"
                android:padding="10dp"
                android:src="@drawable/eraser" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layBrush"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnBrush"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selecterbrush"
                android:padding="10dp"
                android:src="@drawable/brush"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ChoosenImageView_lay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_below="@+id/Layoutbtn"
        android:layout_above="@+id/liner_savebtn"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:scaleType="matrix"
            android:adjustViewBounds="true"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/liner_savebtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:weightSum="2">

        <Button
            android:id="@+id/edit_image"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg_new"
            android:text="Edit"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/save_draw"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:background="@drawable/button_bg_new"
            android:text="Save"
            android:textColor="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="50dp"
        android:gravity="end|bottom">

        <com.sky.atc.easyformse.VerticalSeekBar
            android:id="@+id/seekBar1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/seek_height"
            android:layout_marginBottom="@dimen/margin_bottom"
            android:max="20" />
    </LinearLayout>
</RelativeLayout>