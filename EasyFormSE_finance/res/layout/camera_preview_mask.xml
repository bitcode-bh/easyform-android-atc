<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/firstview"
    android:layout_height="match_parent">

    <View
        android:id="@+id/topview"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:background="@drawable/border_mask"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/viewRectangleMask"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/viewRectangleMask"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:background="@drawable/border"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/viewRectangleMask"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topview" />


    <View
        android:id="@+id/bottomview"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@drawable/border_mask"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewRectangleMask" />

    <View
        android:id="@+id/leftiew"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/border_mask"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomview"
        app:layout_constraintRight_toLeftOf="@id/viewRectangleMask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topview" />

    <View
        android:id="@+id/rightiew"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/border_mask"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@id/viewRectangleMask"
        app:layout_constraintTop_toBottomOf="@id/topview" />

</androidx.constraintlayout.widget.ConstraintLayout>