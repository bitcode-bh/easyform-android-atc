<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:background="@color/black"
    tools:context="NewCameraActivity">


    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/flMainView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/acIvImagePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.otaliastudios.cameraview.CameraView
            android:id="@+id/cvMainCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            app:cameraEngine="camera2"
            app:cameraFacing="back"
            app:cameraFlash="off"
            app:cameraGestureLongTap="autoFocus"
            app:cameraGestureTap="autoFocus"
            app:cameraMode="picture"
            app:cameraAutoFocusResetDelay="0"
            app:cameraPictureMetering="true"
            app:cameraPreview="texture"
            app:cameraPreviewFrameRate="55" />
        <!--app:cameraPictureSizeAspectRatio="1:78"-->
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rlView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@id/flMainView"
        app:layout_constraintEnd_toEndOf="@id/flMainView"
        app:layout_constraintStart_toStartOf="@id/flMainView"
        app:layout_constraintTop_toTopOf="@id/flMainView">

        <com.sky.atc.easyformse.utils.newView.MyBackgroundView
            android:id="@+id/mbView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <View
            android:id="@+id/viewRectangleMask"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hint that travels with the window. This camera frames meter readings
             and barcodes alike, so the wording names neither. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif" android:shadowColor="#99000000" android:shadowRadius="3"
            android:text="Keep it inside the clear area"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/viewRectangleMask"
            app:layout_constraintStart_toStartOf="@id/viewRectangleMask"
            app:layout_constraintTop_toBottomOf="@id/viewRectangleMask" />

        <com.sky.atc.easyformse.utils.newView.MyCustomView
            android:id="@+id/mcvData"
            android:layout_width="100dp"
            android:visibility="gone"
            android:layout_height="100dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpSide"
            android:layout_width="@dimen/common_30_dp"
            android:layout_height="@dimen/common_30_dp"
            android:background="@drawable/round_button_back"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/viewRectangleMask"
            app:layout_constraintTop_toTopOf="@id/viewRectangleMask"
            app:layout_constraintLeft_toLeftOf="@id/viewRectangleMask"
            app:layout_constraintRight_toRightOf="@id/viewRectangleMask" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDownSide"
            android:layout_width="@dimen/common_30_dp"
            android:layout_height="@dimen/common_30_dp"
            android:background="@drawable/round_button_back"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/viewRectangleMask"
            app:layout_constraintLeft_toLeftOf="@id/viewRectangleMask"
            app:layout_constraintRight_toRightOf="@id/viewRectangleMask"
            app:layout_constraintTop_toBottomOf="@id/viewRectangleMask" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartSide"
            android:layout_width="@dimen/common_30_dp"
            android:visibility="gone"
            android:layout_height="@dimen/common_30_dp"
            android:background="@drawable/round_button_back"
            app:layout_constraintStart_toStartOf="@id/viewRectangleMask"
            app:layout_constraintBottom_toBottomOf="@id/viewRectangleMask"
            app:layout_constraintEnd_toStartOf="@id/viewRectangleMask"
            app:layout_constraintTop_toTopOf="@id/viewRectangleMask" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEndSide"
            android:layout_width="@dimen/common_30_dp"
            android:layout_height="@dimen/common_30_dp"
            android:background="@drawable/round_button_back"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/viewRectangleMask"
            app:layout_constraintEnd_toEndOf="@id/viewRectangleMask"
            app:layout_constraintStart_toEndOf="@id/viewRectangleMask"
            app:layout_constraintTop_toTopOf="@id/viewRectangleMask" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@+id/rlCameraViews"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <!-- Close at the top left; readouts and bare controls on the darkened
             bottom of the picture: flash, shutter, switch-camera. -->
        <include layout="@layout/camera_close_control" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/txtSi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cam_heading_underline"
                android:fontFamily="monospace"
                android:paddingBottom="5dp"
                android:text="MF"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMGnt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="MF"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFlash"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:contentDescription="Flash"
                    android:src="@drawable/flashoff_foreground" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivCaptureFront"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Capture"
                    android:src="@drawable/cameraclick_foreground" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSwitchCamera"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:contentDescription="Camera Change"
                    android:src="@drawable/frontcamera_foreground" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:elevation="@dimen/common_50_dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:text="CANCEL" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtCrop"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:text="CROP" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>