<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/camera_viewfinder_tint"
    tools:context=".MainActivity">
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/framlayout"
        android:visibility="visible"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <TextureView
                android:id="@+id/textureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <com.sky.atc.easyformse.utils.newView.ThirdsGridView
                android:id="@+id/ai_preview_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <ImageView
            android:id="@+id/browseimage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:padding="7dp"
            android:visibility="gone"
            android:layout_gravity="top|end"
            android:src="@drawable/browse"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/camera_control_area_top"
            android:layout_gravity="top"
            android:background="@color/camera_overlay_tint" />
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/camera_control_area_bottom"
            android:layout_gravity="bottom"
            android:background="@color/camera_overlay_tint" />
        <include layout="@layout/camera_close_control" />
        <ImageView
            android:id="@+id/switchcamera"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/frontcamera_foreground"
            />
        <ImageView
            android:id="@+id/captureFront"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="18dp"
            android:src="@drawable/cameraclick_foreground" />


    </FrameLayout>
    <ImageView
        android:id="@+id/ai_processing_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/camera_control_area_top"
        android:layout_marginBottom="@dimen/camera_control_area_bottom"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Captured image being checked by AI" />
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <com.sky.atc.easyformse.camera.AiProcessingOverlay
            android:id="@+id/ai_processing_sweep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
             />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/loader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="AI processing…"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:shadowColor="#CC000000"
                android:shadowRadius="4" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
