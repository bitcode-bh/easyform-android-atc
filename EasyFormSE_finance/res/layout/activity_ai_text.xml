<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/framlayout"
        android:layout_height="match_parent">
     <TextureView
            android:id="@+id/textureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/captureFront"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center|bottom"
        android:src="@drawable/cameraclick_foreground"
        android:layout_marginBottom="20dp" />

    </FrameLayout>
    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_background_ai"
        android:orientation="vertical"
        android:id="@+id/linearmain"
        android:visibility="gone"
        android:padding="15dp">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="5sp"
            android:text="AI Chat"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:id="@+id/scrollview"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5sp"
                android:layout_marginRight="5sp"
                android:elevation="2dp"
                android:orientation="vertical"
                >

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="250sp"
                    android:layout_height="250sp"
                    android:layout_gravity="end"
                    android:src="@drawable/atc_logo"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pdftext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8sp"
                    android:layout_marginRight="10sp"
                    android:background="@drawable/image_background"
                    android:gravity="end"
                    android:padding="7sp"
                    android:text="sample_file.pdf"
                    android:textColor="@color/black"
                    android:visibility="gone" />

                <!-- Prompt Text -->
                <TextView
                    android:id="@+id/PromptText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="10sp"
                    android:background="@drawable/image_background"
                    android:padding="10sp"
                    android:singleLine="false"
                    android:text=""
                    android:textColor="#444"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/responselayout"
                android:layout_width="350sp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5sp"
                android:layout_marginTop="15sp"
                android:layout_marginRight="40dp"
                android:visibility="gone"
                android:background="@drawable/text_background"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="7dp"
                    android:singleLine="false"
                    android:text="Response will appear here, please wait..."
                    android:textColor="#555"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnOK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5sp"
                    android:layout_marginRight="2sp"
                    android:backgroundTint="#000000"
                    android:text="DONE"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>