<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtcheckdeveloper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:text="Show Device Details " />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtnshowpermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:layout_gravity="center|top"
            android:text="Show app setting " />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbtncheckattendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10sp"
            android:layout_gravity="center|top"
            android:text="Show attendace Details  " />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/apitoastenble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Api Toast Enable"
            android:layout_marginTop="10dp"
            android:textSize="15dp" />


        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/apilogwrite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Api Log Enable"
            android:layout_marginTop="10dp"
            android:textSize="15dp" />

    </LinearLayout>


</FrameLayout>