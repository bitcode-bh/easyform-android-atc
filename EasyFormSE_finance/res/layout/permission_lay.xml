<?xml version="1.0" encoding="utf-8"?>
<!-- Same tower-photo backdrop as Login.html (login_theme_altius.css), so the
     permission-request screen, the very first thing shown before Login ever
     loads, doesn't read as a separate, unbranded blank-white screen in
     between. android:scaleType="centerCrop" on the ImageView is the
     native-layout equivalent of the web side's background-size:cover; both
     fill the screen without distorting the image's own aspect ratio. The
     light scrim matches Login.html so the new tower artwork still reads. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/login_bg_tower"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:src="@drawable/atc_logo"
            android:layout_marginTop="100dp"
            android:gravity="center|top"
            android:text=""
            android:textColor="@color/white"
            android:textSize="60sp"
            android:typeface="monospace"/>
    </LinearLayout>
</FrameLayout>