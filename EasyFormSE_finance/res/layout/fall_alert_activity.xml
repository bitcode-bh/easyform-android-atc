<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️  FALL DETECTED!"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/subText"
        android:layout_below="@id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alert will be sent automatically when timer runs out."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="25dp"/>

    <TextView
        android:id="@+id/timertext"
        android:layout_centerInParent="true"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:gravity="center"
        android:text="30"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:background="@drawable/circle_bg"/>


    <TextView
        android:id="@+id/btnDecline"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:gravity="center"
        android:padding="18dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_confrom"
        android:text="I'M OKAY"
        />

    <TextView
        android:id="@+id/btconfrom"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:gravity="center"
        android:padding="18dp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_decline"
        android:text="Send Help"
       />



</RelativeLayout>