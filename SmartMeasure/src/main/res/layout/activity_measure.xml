<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
    tools:context=".ui.activitys.MeasureActivity">


    <com.otaliastudios.cameraview.CameraView
        android:id="@+id/cvMainCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"
        app:cameraEngine="camera2"
        app:cameraFacing="back"
        app:cameraFlash="off"
        app:cameraGestureLongTap="none"
        app:cameraGestureTap="none"
        app:cameraMode="picture"
        app:cameraPreview="texture"
        app:cameraPreviewFrameRate="30"
        android:layout_gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <LinearLayout
        android:id="@+id/llLevelCompass"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        android:weightSum="1"
        app:layout_constraintEnd_toStartOf="@id/cvTlaCard"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.easyform.smartmeasure.customViews.GaugeBearing
            android:id="@+id/gauge_bearing_calibrated"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />

        <com.easyform.smartmeasure.customViews.GaugeRotation
            android:id="@+id/gauge_tilt_calibrated"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvTlaCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/acIvAppSetting"
        app:layout_constraintStart_toEndOf="@id/llLevelCompass"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTlaX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="#ffffff"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTlaY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#ffffff"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtvTlaZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#ffffff"
                android:textAppearance="?attr/textAppearanceHeadline6" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtvBaseValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llLevelCompass" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/acIvAppSetting"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="15dp"
        android:clickable="true"
        android:elevation="5dp"
        android:focusable="true"
        android:scaleType="fitXY"
        android:src="@drawable/applications_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cvTlaCard"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white"
        app:tintMode="multiply" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitXY"
        android:src="@drawable/center_focus_screen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@android:color/white"
        app:tintMode="multiply" />


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/sIvStartImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="15dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/acIvClickImage"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearance="@style/CustomShapeOVerlay" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/acIvClickImage"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:elevation="5dp"
        android:focusable="true"
        android:scaleType="fitXY"
        android:src="@drawable/measure_camera_click"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sIvEndImage"
        app:layout_constraintStart_toEndOf="@id/sIvStartImage"
        app:tint="@android:color/white"
        app:tintMode="multiply" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/sIvEndImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="15dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/acIvClickImage"
        app:shapeAppearance="@style/CustomShapeOVerlay" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/cpIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackThickness="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>