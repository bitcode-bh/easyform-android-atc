<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:weightSum="1"
    android:background="@drawable/arrowalertdialborder"
    android:layout_height="wrap_content"
    tools:ignore="MissingDefaultResource">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        android:layout_weight="0.4"
        android:weightSum="10"
        android:layout_height="0dp">
        <ImageView
            android:id="@+id/img_down"
            android:layout_width="0dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_down_foreground"
            android:layout_height="50dp"
            android:contentDescription="TODO"
            tools:ignore="ContentDescription,HardcodedText,NestedWeights" />
        <ImageView
            android:id="@+id/img_up"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_margin="5dp"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_up_foreground"
            android:layout_height="50dp"
            tools:ignore="ContentDescription" />
        <ImageView
            android:id="@+id/img_left"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_margin="5dp"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_left_foreground"
            android:layout_height="50dp"
            tools:ignore="ContentDescription" />
        <ImageView
            android:id="@+id/img_right"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_margin="5dp"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_right"
            android:layout_height="50dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_margin="20dp"
        android:layout_weight="0.4"
        android:weightSum="10"
        android:layout_height="0dp">
        <ImageView

            android:id="@+id/color_blue"
            android:layout_width="0dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:src="#0d70b3"
            android:layout_height="50dp"
            tools:ignore="ContentDescription,NestedWeights" />
        <ImageView
            android:id="@+id/color_green"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_margin="5dp"
            android:src="#1cba48"
            android:layout_height="50dp"
            tools:ignore="ContentDescription" />
        <ImageView
            android:id="@+id/color_orange"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_margin="5dp"
            android:src="@android:color/holo_orange_dark"
            android:layout_height="50dp"
            tools:ignore="ContentDescription" />
        <ImageView
            android:id="@+id/color_yellow"
            android:layout_width="0dp"
            android:layout_weight="2.5"
            android:layout_margin="5dp"
            android:src="#FFEB3B"
            android:layout_height="50dp"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_gravity="center"
        android:layout_weight="0.2"
        android:gravity="center"
        android:layout_margin="10dp"
        android:layout_height="0dp">

        <Button
            android:id="@+id/btn_arrowselect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#000000"
            android:textSize="20sp"
            android:background="@drawable/arrowalertdialborder"
            android:text="@string/ok" />
    </LinearLayout>

</LinearLayout>