<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activitys.JitsiMeetViewActivity">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/jitsi_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="right"
        android:layout_margin="20dp"
        android:background="@drawable/ic_more_icon"
        tools:ignore="RtlHardcoded" />


    <com.easyform.jitsi.utils.MovableFloatingActionButton
        android:id="@+id/stopShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|right"
        android:src="@drawable/ic_stopscreen"
        android:visibility="gone" />

    <com.easyform.jitsi.utils.MovableFloatingActionButton
        android:id="@+id/draw_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="60dp"
        android:src="@drawable/ic_pen"
        android:visibility="gone" />

    <!--    <com.google.android.material.button.MaterialButton-->
    <!--        android:id="@+id/stopShare"-->
    <!--        android:layout_width="wrap_content"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_gravity="center|right"-->
    <!--        android:background="#D50000"-->
    <!--        android:text="STOP"-->
    <!--        android:textColor="#fff"-->
    <!--        android:textSize="30dp"-->
    <!--        android:visibility="gone" />-->

    <com.github.ybq.android.spinkit.SpinKitView
        android:id="@+id/spin_kit"
        style="@style/SpinKitView.MultiplePulseRing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:SpinKit_Color="#E4123B" />

</FrameLayout>