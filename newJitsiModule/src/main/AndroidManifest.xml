<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.easyform.newjitsi">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application>
        <activity
            android:name=".activitys.JitsiMeetCustomActivity"
            android:exported="false" />
        <activity
            android:name=".activitys.ProgressActivity"
            android:noHistory="true"
            android:exported="false" />

        <receiver
            android:name=".broadcasts.JitsiPluginBroadcast"
            android:exported="false">
            <intent-filter>
                <action android:name="com.easyform.newjitsi.JitsiPluginCall" />
                <action android:name="com.easyform.newjitsi.notification" />
            </intent-filter>
        </receiver>
    </application>

</manifest>