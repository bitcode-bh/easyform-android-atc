<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming video call, in the app's Home language: a light page, the caller
     on a grey card, and two plain buttons, Decline and Answer.
     rejectBtn and takeBtn are still the ImageButtons the activity listens to;
     each fills its button, with the icon and word drawn on top of it (those
     take no touches, so a tap anywhere on the button reaches it). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentIncomeCall"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFBFBFC">

    <LinearLayout
        android:id="@+id/infoAboutCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/incomingButtons"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/incoming_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="34dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <View
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/incoming_avatar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.09"
                android:text="VIDEO CALL"
                android:textColor="#FF6B7280"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/type_inc_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="..."
                android:textColor="#FF0F1729"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/incomingButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/rejectBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/incoming_btn_decline"
                android:contentDescription="Decline" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_baseline_call_end_24"
                    android:tint="#FFA32D2D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Decline"
                    android:textColor="#FFA32D2D"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/takeBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/incoming_btn_answer"
                android:contentDescription="Answer" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_baseline_call_64"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Answer"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
