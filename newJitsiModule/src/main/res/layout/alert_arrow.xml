<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/arrowalertdialborder"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:layout_weight="0.4"
        android:orientation="horizontal"
        android:weightSum="10">

        <ImageView
            android:id="@+id/img_down"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_down_foreground" />

        <ImageView
            android:id="@+id/img_up"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_up_foreground" />

        <ImageView
            android:id="@+id/img_left"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_left_foreground" />

        <ImageView
            android:id="@+id/img_right"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:background="@drawable/backgound_alert_arrow"
            android:src="@drawable/ic_arrow_right_my" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:layout_weight="0.4"
        android:orientation="horizontal"
        android:weightSum="10">

        <ImageView

            android:id="@+id/color_blue"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:src="@color/blue" />

        <ImageView
            android:id="@+id/color_green"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:src="@color/green" />

        <ImageView
            android:id="@+id/color_orange"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:src="@android:color/holo_orange_dark" />

        <ImageView
            android:id="@+id/color_yellow"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:layout_weight="2.5"
            android:src="@color/yellow" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_arrowselect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/arrowalertdialborder"
            android:text="OK"
            android:textColor="@color/black"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>