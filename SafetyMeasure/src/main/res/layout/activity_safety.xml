<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SafetyMeasureActivity">

    <RelativeLayout
        android:id="@+id/relativeLayout_detect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <TextureView
            android:id="@+id/textureView_camera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/button_detect"
            android:layout_centerHorizontal="true"
            />
        <ImageView
            android:id="@+id/switchcamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="camera_change"
            android:src="@drawable/frontcamera_foreground"
            android:layout_alignParentEnd="true"/>
        <!-- Add this transparent view overlay -->
        <com.easyform.safetymeasure.OverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/button_detect"
            android:layout_centerHorizontal="true"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/imageView_detection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/button_detect"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            />
        <TextView
            android:id="@+id/button_detect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_margin="10dp"
            android:background="@color/black"
            android:textColor="@color/white"
            android:padding="10dp"
            android:visibility="gone"
            android:gravity="center"
            android:textAlignment="center"
            android:text="Detect" />
    </RelativeLayout>
</RelativeLayout>